{
  "schemaVersion": 2,
  "id": "network-sim",
  "title": "Network Sim",
  "function": "Simulation réseau (package standard)",
  "version": "1.1.0",
  "createdAt": "2025-07-08",
  "author": "EZGalaxy",
  "docker": {
    "dockerfile": "Dockerfile",
    "port": 8000,
    "env": {
      "DB_PATH": "/app/data/database.sqlite"
    },
    "volumes": [
      "/app/data"
    ],
    "healthcheck": {
      "endpoint": "/health",
      "interval": 30,
      "timeout": 10
    }
  }
}
