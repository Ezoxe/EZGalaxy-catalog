{
  "schemaVersion": 2,
  "id": "com.ezgalaxy.neurocards",
  "title": "NeuroCards",
  "function": "Flashcards à répétition espacée (algorithme SM-2) avec création de decks, sessions de révision et statistiques de progression.",
  "version": "1.0.0",
  "createdAt": "2026-02-15",
  "author": "EZGalaxy Community",
  "docker": {
    "dockerfile": "Dockerfile",
    "port": 3000,
    "env": {
      "NODE_ENV": "production",
      "DB_PATH": "/app/data/database.sqlite"
    },
    "volumes": [
      "/app/data"
    ],
    "healthcheck": {
      "endpoint": "/health",
      "interval": 30,
      "timeout": 10
    }
  }
}
