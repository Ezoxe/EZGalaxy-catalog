{
  "schemaVersion": 2,
  "id": "com.ezgalaxy.chroma",
  "title": "ChromaLab",
  "function": "Générateur de palettes de couleurs harmoniques avec vérification de contraste WCAG, export CSS/JSON et sauvegarde cloud.",
  "version": "1.0.0",
  "createdAt": "2026-02-15",
  "author": "EZGalaxy Community",
  "docker": {
    "dockerfile": "Dockerfile",
    "port": 3000,
    "env": {
      "NODE_ENV": "production",
      "DB_PATH": "/app/data/database.sqlite"
    },
    "volumes": [
      "/app/data"
    ],
    "healthcheck": {
      "endpoint": "/health",
      "interval": 30,
      "timeout": 10
    }
  }
}
