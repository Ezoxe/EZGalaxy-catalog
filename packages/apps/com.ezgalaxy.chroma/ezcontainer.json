{
  "schemaVersion": 2,
  "id": "com.ezgalaxy.chroma",
  "title": "ChromaLab",
  "function": "Générateur de palettes de couleurs avec harmonies, contraste WCAG et export multi-formats",
  "version": "1.0.0",
  "createdAt": "2025-07-08",
  "author": "EZGalaxy",
  "docker": {
    "dockerfile": "Dockerfile",
    "port": 8000,
    "env": {
      "DB_PATH": "/app/data/database.sqlite"
    },
    "volumes": [
      "/app/data"
    ],
    "healthcheck": {
      "endpoint": "/health",
      "interval": 30,
      "timeout": 10
    }
  }
}
