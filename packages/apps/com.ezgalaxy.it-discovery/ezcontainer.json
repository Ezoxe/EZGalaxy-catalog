{
  "schemaVersion": 2,
  "id": "com.ezgalaxy.it-discovery",
  "title": "IT Discovery",
  "function": "Découvre l'informatique de manière ludique et interactive — modules, quiz, badges et gamification pour les 14 ans et +",
  "version": "1.0.0",
  "createdAt": "2025-07-08",
  "author": "EZGalaxy",
  "docker": {
    "dockerfile": "Dockerfile",
    "port": 8000,
    "env": {
      "DB_PATH": "/app/data/database.sqlite"
    },
    "volumes": [
      "/app/data"
    ],
    "healthcheck": {
      "endpoint": "/health",
      "interval": 30,
      "timeout": 10
    }
  }
}
