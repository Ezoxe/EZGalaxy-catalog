{
  "schemaVersion": 2,
  "id": "com.ezgalaxy.kanflow",
  "title": "KanFlow",
  "function": "Tableau Kanban avec drag & drop, multi-tableaux, tags colorés et dates d'échéance",
  "version": "1.0.0",
  "createdAt": "2025-07-08",
  "author": "EZGalaxy",
  "docker": {
    "dockerfile": "Dockerfile",
    "port": 8000,
    "env": {
      "DB_PATH": "/app/data/database.sqlite"
    },
    "volumes": [
      "/app/data"
    ],
    "healthcheck": {
      "endpoint": "/health",
      "interval": 30,
      "timeout": 10
    }
  }
}
