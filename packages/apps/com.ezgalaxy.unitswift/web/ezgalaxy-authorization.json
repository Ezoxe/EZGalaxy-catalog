{
  "schemaVersion": 1,
  "packageId": "com.ezgalaxy.unitswift",
  "capabilities": [
    {
      "name": "network.outgoing",
      "enabled": true,
      "details": { "allowedOrigins": [] },
      "justification": "Same-origin EZGalaxy SDK calls for Community Data API storage."
    },
    {
      "name": "communityDataApi",
      "enabled": true,
      "details": {
        "collections": [
          { "name": "favorites", "scope": "private", "description": "Conversions favorites" },
          { "name": "history", "scope": "private", "description": "Historique de conversions" }
        ]
      },
      "justification": "Sauvegarder les favoris et l'historique."
    }
  ]
}