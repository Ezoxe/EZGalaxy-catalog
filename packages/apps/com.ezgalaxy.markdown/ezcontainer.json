{
  "schemaVersion": 2,
  "id": "com.ezgalaxy.markdown",
  "title": "MarkDown Studio",
  "function": "Éditeur Markdown split-view avec aperçu temps réel, barre d'outils et gestion multi-documents",
  "version": "1.0.0",
  "createdAt": "2025-07-08",
  "author": "EZGalaxy",
  "docker": {
    "dockerfile": "Dockerfile",
    "port": 8000,
    "env": {
      "DB_PATH": "/app/data/database.sqlite"
    },
    "volumes": [
      "/app/data"
    ],
    "healthcheck": {
      "endpoint": "/health",
      "interval": 30,
      "timeout": 10
    }
  }
}
