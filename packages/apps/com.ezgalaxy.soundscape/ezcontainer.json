{
  "schemaVersion": 2,
  "id": "com.ezgalaxy.soundscape",
  "title": "SoundScape",
  "function": "Mixeur de sons ambiants pour la concentration, la relaxation et le sommeil",
  "version": "1.0.0",
  "createdAt": "2026-02-22",
  "author": "EZGalaxy",
  "docker": {
    "dockerfile": "Dockerfile",
    "port": 3000,
    "env": {
      "NODE_ENV": "production",
      "DB_PATH": "/app/data/database.sqlite"
    },
    "volumes": [
      "/app/data"
    ],
    "healthcheck": {
      "endpoint": "/health",
      "interval": 30,
      "timeout": 10
    }
  }
}
